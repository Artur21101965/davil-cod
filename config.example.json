{
  "$comment": "Copy to config.json. Keys go in .env, not here. Custom providers beyond the catalog go here.",
  "port": 4000,
  "auth": "your-secret-key-here",
  "rateLimit": { "maxRequests": 100, "windowMs": 60000 },
  "modelManager": {
    "enabled": true,
    "intervalHours": 6,
    "autoAdd": true,
    "recheckDisabledDays": 7
  },
  "methodology": {
    "enabled": true,
    "prompts": {
      "coding": "Перед кодом — краткий план. Следи, чтобы тест описывал поведение.",
      "reasoning": "Рассуждай пошагово, показывай допущения, затем вывод."
    }
  },
  "websearch": {
    "enabled": true,
    "limit": 5,
    "timeout": 8000,
    "queryMinChars": 6
  },
  "vetting": {
    "enabled": false,
    "minAnswerLen": 120,
    "maxChecksPerMin": 4,
    "complexityOnly": true
  },
  "routing": {
    "strategy": "weighted",
    "preference": "free-first"
  },
  "compress": {
    "enabled": false,
    "minLen": 60
  },
  "autoUpdate": {
    "enabled": false,
    "intervalHours": 12
  },
  "providers": {
    "or-nemotron-550b": {
      "endpoint": "https://openrouter.ai/api/v1/chat/completions",
      "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
      "priority": 11,
      "dailyLimit": 50,
      "keyHint": "openrouter.ai → Keys",
      "envVar": "PROVIDER_OPENROUTER_APIKEY",
      "free": true
    },
    "sambanova-gpt-oss-120b": {
      "endpoint": "https://api.sambanova.ai/v1/chat/completions",
      "model": "gpt-oss-120b",
      "priority": 12,
      "dailyLimit": 100000,
      "keyHint": "cloud.sambanova.ai → API Keys",
      "envVar": "PROVIDER_SAMBANOVA_APIKEY",
      "free": true,
      "category": "general"
    },
    "siliconflow-deepseek-r1": {
      "endpoint": "https://api.siliconflow.com/v1/chat/completions",
      "model": "deepseek-ai/DeepSeek-R1",
      "priority": 12,
      "dailyLimit": 100000,
      "keyHint": "cloud.siliconflow.com → API Keys",
      "envVar": "PROVIDER_SILICONFLOW_APIKEY",
      "free": true,
      "category": "reasoning"
    }
  }
}
