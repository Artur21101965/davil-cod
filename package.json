{
  "name": "davil-cod",
  "version": "0.6.0",
  "description": "Free multi-provider LLM proxy with automatic failover. One OpenAI-compatible endpoint routes to 18 free models (Groq, Mistral, Gemini, NIM, OpenRouter, ZAI). Never pay for LLMs.",
  "license": "MIT",
  "bin": {
    "davil-cod": "./bin/davil-cod.js"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 test/proxy.test.js test/clean.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "llm",
    "proxy",
    "free",
    "openai",
    "failover",
    "groq",
    "mistral",
    "gemini",
    "llm-gateway",
    "multi-provider",
    "self-hosted",
    "vision"
  ],
  "files": [
    "server.js",
    "lib/",
    "providers.json",
    "config.example.json",
    ".env.example",
    "bin/",
    "assets/",
    "README.md",
    "README.ru.md"
  ]
}
